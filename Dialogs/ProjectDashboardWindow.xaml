<Window x:Class="VANTAGE.Dialogs.ProjectDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        Title="Project Dashboard"
        Height="900"
        Width="1500"
        MinHeight="500"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundColor}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Reserved top toolbar for future dashboard controls -->
            <RowDefinition Height="Auto"/>
            <!-- Dashboard web view -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource DarkestBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Reserved space for future toolbar controls -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title + status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Project Dashboard"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ToolbarForeground}"/>
                    <TextBlock x:Name="txtStatus"
                               Text=""
                               FontSize="11"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource StatusBarForeground}"/>
                </StackPanel>

                <!-- Right-aligned actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnRefresh"
                            Content="Refresh"
                            Width="90"
                            Height="30"
                            Margin="0,0,10,0"
                            Background="{DynamicResource ControlBackground}"
                            Foreground="{DynamicResource ForegroundColor}"
                            BorderBrush="{DynamicResource ControlBorder}"
                            Click="BtnRefresh_Click"
                            ToolTip="Reload the dashboard from the current local database"/>
                    <Button x:Name="btnOpenInBrowser"
                            Content="Open in Browser"
                            Width="130"
                            Height="30"
                            Background="{DynamicResource ControlBackground}"
                            Foreground="{DynamicResource ForegroundColor}"
                            BorderBrush="{DynamicResource ControlBorder}"
                            Click="BtnOpenInBrowser_Click"
                            ToolTip="Save a standalone snapshot of the current dashboard and open it in your default browser"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dashboard. The WebView2 is kept HIDDEN until the page reports it has fully
             rendered (rendered:true handshake), so none of Chromium's intermediate paint
             states leak through. A cream phased-loading overlay (spinner + status) covers
             the area until then. The report is intentionally theme-neutral (always cream),
             so this overlay is not theme-bound. -->
        <Grid Grid.Row="1" Background="#FAF9F5">
            <wv2:WebView2 x:Name="webView" Visibility="Hidden"/>

            <!-- Phased loading overlay -->
            <Border x:Name="loadingOverlay" Background="#FAF9F5">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <syncfusion:SfBusyIndicator x:Name="busyIndicator"
                                                IsBusy="True"
                                                AnimationType="DualRing"
                                                ViewboxWidth="48"
                                                ViewboxHeight="48"
                                                Foreground="#1E1B6B"/>
                    <TextBlock x:Name="txtLoadingPhase"
                               Text="Preparing report…"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#6B6B76"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
