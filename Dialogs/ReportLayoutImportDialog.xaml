<Window x:Class="VANTAGE.Dialogs.ReportLayoutImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Report Layout from Cloud"
        Height="460"
        Width="600"
        MinHeight="320"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundColor}"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Pick a shared layout to import a local copy. Importing does not link back — it's a one-time copy."
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Foreground="{DynamicResource ForegroundColor}"/>

        <ListView Grid.Row="1"
                  x:Name="lstLayouts"
                  Background="{DynamicResource ControlBackground}"
                  Foreground="{DynamicResource ForegroundColor}"
                  BorderBrush="{DynamicResource ControlBorder}"
                  MouseDoubleClick="LstLayouts_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="250" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Author" Width="150" DisplayMemberBinding="{Binding Author}"/>
                    <GridViewColumn Header="Updated" Width="150" DisplayMemberBinding="{Binding UpdatedLocal}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btnDelete"
                    Content="Delete from Cloud"
                    Width="140" Height="30" Margin="0,0,10,0"
                    Visibility="Collapsed"
                    Background="{DynamicResource ControlBackground}"
                    Foreground="{DynamicResource ForegroundColor}"
                    BorderBrush="{DynamicResource ControlBorder}"
                    Click="BtnDelete_Click"
                    ToolTip="Admins only — remove this layout from the shared Cloud library for everyone"/>
            <Button x:Name="btnImport"
                    Content="Import"
                    Width="90" Height="30" Margin="0,0,10,0"
                    Background="{DynamicResource ControlBackground}"
                    Foreground="{DynamicResource ForegroundColor}"
                    BorderBrush="{DynamicResource ControlBorder}"
                    Click="BtnImport_Click"/>
            <Button x:Name="btnCancel"
                    Content="Cancel"
                    Width="90" Height="30"
                    Background="{DynamicResource ControlBackground}"
                    Foreground="{DynamicResource ForegroundColor}"
                    BorderBrush="{DynamicResource ControlBorder}"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
