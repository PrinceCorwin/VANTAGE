<Window x:Class="VANTAGE.Dialogs.DatabaseManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        Title="Database Manager"
        Width="760" Height="520"
        MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundColor}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Database Manager"
                       Foreground="{DynamicResource ForegroundColor}"
                       FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Keep separate local databases per project so you can switch between them without clearing and re-syncing. Switching restarts VANTAGE; the database you leave is kept untouched."
                       Foreground="{DynamicResource ForegroundColor}"
                       Opacity="0.75" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Database list -->
        <syncfusion:SfDataGrid x:Name="grdDatabases"
                               Grid.Row="2"
                               AutoGenerateColumns="False"
                               AllowEditing="False"
                               AllowSorting="True"
                               AllowResizingColumns="True"
                               SelectionMode="Single"
                               ColumnSizer="Star"
                               HeaderRowHeight="34"
                               RowHeight="32"
                               MouseDoubleClick="GrdDatabases_MouseDoubleClick">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="ActiveMarker" HeaderText="Active"
                                           ColumnSizer="Auto" MinimumWidth="60"
                                           TextAlignment="Center"/>
                <syncfusion:GridTextColumn MappingName="Name" HeaderText="Name"
                                           ColumnSizer="Star" MinimumWidth="160"/>
                <syncfusion:GridTextColumn MappingName="ActivitiesText" HeaderText="Activities"
                                           ColumnSizer="Auto" MinimumWidth="90"
                                           TextAlignment="Right"/>
                <syncfusion:GridTextColumn MappingName="SizeText" HeaderText="Size"
                                           ColumnSizer="Auto" MinimumWidth="90"
                                           TextAlignment="Right"/>
                <syncfusion:GridTextColumn MappingName="LastUsedText" HeaderText="Last Used"
                                           ColumnSizer="Auto" MinimumWidth="140"/>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <!-- Toolbar -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="txtStatus"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ForegroundColor}"
                       Opacity="0.75" FontSize="12" TextWrapping="Wrap"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnSwitch"
                        Content="Switch To"
                        Width="100" Height="34" Margin="0,0,10,0"
                        Background="{DynamicResource AccentColor}"
                        Foreground="{DynamicResource ForegroundColor}"
                        BorderBrush="{DynamicResource AccentColor}"
                        BorderThickness="1"
                        Click="BtnSwitch_Click"
                        ToolTip="Make the selected database active (restarts VANTAGE)"/>
                <Button x:Name="btnCreate"
                        Content="Create New..."
                        Width="110" Height="34" Margin="0,0,10,0"
                        Background="{DynamicResource ControlBackground}"
                        Foreground="{DynamicResource ForegroundColor}"
                        BorderBrush="{DynamicResource ControlBorder}"
                        BorderThickness="1"
                        Click="BtnCreate_Click"
                        ToolTip="Create a new empty database you can sync a different project into"/>
                <Button x:Name="btnRename"
                        Content="Rename..."
                        Width="90" Height="34" Margin="0,0,10,0"
                        Background="{DynamicResource ControlBackground}"
                        Foreground="{DynamicResource ForegroundColor}"
                        BorderBrush="{DynamicResource ControlBorder}"
                        BorderThickness="1"
                        Click="BtnRename_Click"
                        ToolTip="Rename the selected database (the file on disk is not affected)"/>
                <Button x:Name="btnDelete"
                        Content="Delete"
                        Width="90" Height="34" Margin="0,0,10,0"
                        Background="{DynamicResource ControlBackground}"
                        Foreground="{DynamicResource ForegroundColor}"
                        BorderBrush="{DynamicResource ControlBorder}"
                        BorderThickness="1"
                        Click="BtnDelete_Click"
                        ToolTip="Permanently delete the selected database file (cannot delete the active one)"/>
                <Button Content="Close"
                        Width="90" Height="34"
                        Background="{DynamicResource ControlBackground}"
                        Foreground="{DynamicResource ForegroundColor}"
                        BorderBrush="{DynamicResource ControlBorder}"
                        BorderThickness="1"
                        IsCancel="True"
                        ToolTip="Close this window"/>
            </StackPanel>
        </Grid>

        <!-- Busy overlay -->
        <Grid x:Name="pnlBusy"
              Grid.RowSpan="5"
              Background="#99000000"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <syncfusion:SfBusyIndicator IsBusy="True"
                                            AnimationType="DualRing"
                                            ViewboxWidth="70" ViewboxHeight="70"
                                            Foreground="{DynamicResource AccentColor}"
                                            HorizontalAlignment="Center"/>
                <TextBlock x:Name="txtBusy"
                           Text="Working..."
                           Foreground="White"
                           FontSize="14"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
