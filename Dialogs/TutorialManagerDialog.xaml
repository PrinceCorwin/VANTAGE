<Window x:Class="VANTAGE.Dialogs.TutorialManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        Title="Manage Tutorials"
        Width="820" Height="560"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundColor}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Manage Tutorials"
                       Foreground="{DynamicResource ForegroundColor}"
                       FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Upload, edit, and delete the tutorial videos shown in the app's Tutorials list. Changes are live immediately."
                       Foreground="{DynamicResource ForegroundColor}"
                       Opacity="0.75" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Tutorials list -->
        <syncfusion:SfDataGrid x:Name="grdTutorials"
                               Grid.Row="2"
                               AutoGenerateColumns="False"
                               AllowEditing="False"
                               AllowSorting="True"
                               AllowFiltering="True"
                               AllowResizingColumns="True"
                               SelectionMode="Single"
                               ColumnSizer="Star"
                               HeaderRowHeight="34"
                               RowHeight="32">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="Key" HeaderText="File" ColumnSizer="Auto" MinimumWidth="160"/>
                <syncfusion:GridTextColumn MappingName="Name" HeaderText="Title" ColumnSizer="Auto" MinimumWidth="160"/>
                <syncfusion:GridTextColumn MappingName="Description" HeaderText="Description" ColumnSizer="Star"/>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <!-- Toolbar -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="txtStatus"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ForegroundColor}"
                       Opacity="0.75" FontSize="12" TextWrapping="Wrap"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnUpload"
                        Content="Upload New..."
                        Width="120" Height="34" Margin="0,0,10,0"
                        Background="{DynamicResource AccentColor}"
                        Foreground="{DynamicResource ForegroundColor}"
                        BorderBrush="{DynamicResource AccentColor}"
                        BorderThickness="1"
                        Click="BtnUpload_Click"
                        ToolTip="Add a new tutorial video"/>
                <Button x:Name="btnEdit"
                        Content="Edit Details..."
                        Width="110" Height="34" Margin="0,0,10,0"
                        Background="{DynamicResource ControlBackground}"
                        Foreground="{DynamicResource ForegroundColor}"
                        BorderBrush="{DynamicResource ControlBorder}"
                        BorderThickness="1"
                        Click="BtnEdit_Click"
                        ToolTip="Edit the selected tutorial's title and description"/>
                <Button x:Name="btnDelete"
                        Content="Delete"
                        Width="90" Height="34" Margin="0,0,10,0"
                        Background="{DynamicResource ControlBackground}"
                        Foreground="{DynamicResource ForegroundColor}"
                        BorderBrush="{DynamicResource ControlBorder}"
                        BorderThickness="1"
                        Click="BtnDelete_Click"
                        ToolTip="Delete the selected tutorial video"/>
                <Button x:Name="btnRefresh"
                        Content="Refresh"
                        Width="90" Height="34" Margin="0,0,10,0"
                        Background="{DynamicResource ControlBackground}"
                        Foreground="{DynamicResource ForegroundColor}"
                        BorderBrush="{DynamicResource ControlBorder}"
                        BorderThickness="1"
                        Click="BtnRefresh_Click"
                        ToolTip="Reload the tutorial list"/>
                <Button Content="Close"
                        Width="90" Height="34"
                        Background="{DynamicResource ControlBackground}"
                        Foreground="{DynamicResource ForegroundColor}"
                        BorderBrush="{DynamicResource ControlBorder}"
                        BorderThickness="1"
                        IsCancel="True"
                        ToolTip="Close this window"/>
            </StackPanel>
        </Grid>

        <!-- Busy overlay -->
        <Grid x:Name="pnlBusy"
              Grid.RowSpan="5"
              Background="#99000000"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <syncfusion:SfBusyIndicator IsBusy="True"
                                            AnimationType="DualRing"
                                            ViewboxWidth="70" ViewboxHeight="70"
                                            Foreground="{DynamicResource AccentColor}"
                                            HorizontalAlignment="Center"/>
                <TextBlock x:Name="txtBusy"
                           Text="Working..."
                           Foreground="White"
                           FontSize="14"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
