<Window x:Class="VANTAGE.Dialogs.TutorialEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tutorial"
        SizeToContent="Height"
        Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundColor}"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="20,20,20,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="txtHeader"
                   Grid.Row="0"
                   Text="Upload New Tutorial"
                   Foreground="{DynamicResource ForegroundColor}"
                   FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

        <!-- File picker (New mode only) -->
        <TextBlock x:Name="lblFile"
                   Grid.Row="1"
                   Text="Video file"
                   Foreground="{DynamicResource ForegroundColor}"
                   FontSize="12" Margin="0,0,0,4"/>
        <Grid x:Name="pnlFile" Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtFile"
                     Grid.Column="0"
                     Height="32" IsReadOnly="True"
                     VerticalContentAlignment="Center"
                     Padding="8,0,8,0"
                     Background="{DynamicResource ControlBackground}"
                     Foreground="{DynamicResource ControlForeground}"
                     BorderBrush="{DynamicResource ControlBorder}"
                     BorderThickness="1"
                     ToolTip="The .mp4 file to upload"/>
            <Button x:Name="btnBrowse"
                    Grid.Column="2"
                    Content="Browse..."
                    Width="90" Height="32"
                    Background="{DynamicResource ControlBackground}"
                    Foreground="{DynamicResource ForegroundColor}"
                    BorderBrush="{DynamicResource ControlBorder}"
                    BorderThickness="1"
                    Click="BtnBrowse_Click"
                    ToolTip="Choose the video file"/>
        </Grid>

        <!-- Inspection readout (New mode only) -->
        <Border x:Name="pnlInspect"
                Grid.Row="3"
                Margin="0,0,0,10"
                Padding="10,8"
                Background="{DynamicResource ControlBackground}"
                BorderBrush="{DynamicResource ControlBorder}"
                BorderThickness="1"
                Visibility="Collapsed">
            <TextBlock x:Name="txtInspect"
                       Foreground="{DynamicResource ForegroundColor}"
                       FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- Filename / key (New mode only) -->
        <TextBlock x:Name="lblKey"
                   Grid.Row="4"
                   Text="Filename (self-sorts by leading number, e.g. 10-Vantage-Foo.mp4)"
                   Foreground="{DynamicResource ForegroundColor}"
                   FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="txtKey"
                 Grid.Row="5"
                 Height="32" MaxLength="120"
                 VerticalContentAlignment="Center"
                 Padding="8,0,8,0"
                 Margin="0,0,0,10"
                 Background="{DynamicResource ControlBackground}"
                 Foreground="{DynamicResource ControlForeground}"
                 BorderBrush="{DynamicResource ControlBorder}"
                 BorderThickness="1"
                 ToolTip="The stored filename (S3 key). Must end in .mp4"/>

        <!-- Title -->
        <TextBlock Grid.Row="6"
                   Text="Title (shown in the Tutorials list)"
                   Foreground="{DynamicResource ForegroundColor}"
                   FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="txtName"
                 Grid.Row="7"
                 Height="32" MaxLength="100"
                 VerticalContentAlignment="Center"
                 Padding="8,0,8,0"
                 Margin="0,0,0,10"
                 Background="{DynamicResource ControlBackground}"
                 Foreground="{DynamicResource ControlForeground}"
                 BorderBrush="{DynamicResource ControlBorder}"
                 BorderThickness="1"
                 ToolTip="Display title, e.g. '10 - Vantage: Something'"/>

        <!-- Description -->
        <TextBlock Grid.Row="8"
                   Text="Description"
                   Foreground="{DynamicResource ForegroundColor}"
                   FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="txtDesc"
                 Grid.Row="9"
                 Height="32" MaxLength="200"
                 Margin="0,0,0,10"
                 VerticalContentAlignment="Center"
                 Padding="8,0,8,0"
                 Background="{DynamicResource ControlBackground}"
                 Foreground="{DynamicResource ControlForeground}"
                 BorderBrush="{DynamicResource ControlBorder}"
                 BorderThickness="1"
                 ToolTip="One-line description shown under the title"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="11"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="90" Height="34"
                    Margin="0,0,10,0"
                    Background="{DynamicResource ControlBackground}"
                    Foreground="{DynamicResource ForegroundColor}"
                    BorderBrush="{DynamicResource ControlBorder}"
                    BorderThickness="1"
                    IsCancel="True"/>
            <Button x:Name="btnOk"
                    Content="OK"
                    Width="90" Height="34"
                    Background="{DynamicResource AccentColor}"
                    Foreground="{DynamicResource ForegroundColor}"
                    BorderBrush="{DynamicResource AccentColor}"
                    BorderThickness="1"
                    IsDefault="True"
                    Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
