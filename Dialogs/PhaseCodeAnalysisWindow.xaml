<Window x:Class="VANTAGE.Dialogs.PhaseCodeAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:converters="clr-namespace:VANTAGE.Converters"
        Title="Phase Code Analysis"
        Height="800"
        Width="1200"
        MinHeight="400"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundColor}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Default TextBlock style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
        </Style>

        <!-- Converter for % Complete cell coloring -->
        <converters:PercentToColorConverter x:Key="PercentToColorConverter"/>

        <!-- CellStyle for % Complete column with conditional coloring -->
        <Style x:Key="PercentColorStyle" TargetType="syncfusion:GridCell" BasedOn="{StaticResource {x:Type syncfusion:GridCell}}">
            <Setter Property="Background" Value="{Binding PercentComplete, Converter={StaticResource PercentToColorConverter}}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter / toolbar controls -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
            <!-- Group By -->
            <TextBlock Text="Group By:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="cmbGroupBy"
                      MinWidth="120"
                      SelectionChanged="CmbGroupBy_SelectionChanged"
                      ToolTip="Select field to group activities by"/>

            <Rectangle Width="1" Fill="{DynamicResource ControlBorder}" Margin="12,2"/>

            <!-- User Filter. Explicit GroupName so these don't share a group with the
                 Source radios below (all four would auto-group as one set otherwise). -->
            <RadioButton x:Name="rbCurrentUser" Content="My Records"
                         GroupName="PhaseCodeUserFilter"
                         VerticalAlignment="Center" Margin="8,0"
                         Foreground="{DynamicResource ForegroundColor}"
                         Checked="UserFilter_Changed"
                         ToolTip="Show only records assigned to you"/>
            <RadioButton x:Name="rbAllUsers" Content="All Users"
                         GroupName="PhaseCodeUserFilter"
                         VerticalAlignment="Center" Margin="8,0"
                         Foreground="{DynamicResource ForegroundColor}"
                         Checked="UserFilter_Changed"
                         ToolTip="Show records from all users"/>

            <Rectangle Width="1" Fill="{DynamicResource ControlBorder}" Margin="12,2"/>

            <!-- Project Filter (multi-select). Built from plain WPF (ToggleButton + Popup +
                 checkbox list) rather than a Syncfusion multi-select ComboBoxAdv, whose
                 dropdown template does not render in a standalone Window. -->
            <TextBlock Text="Projects:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Grid>
                <ToggleButton x:Name="btnProjects"
                              MinWidth="150"
                              Padding="8,3"
                              HorizontalContentAlignment="Stretch"
                              Background="{DynamicResource ControlBackground}"
                              Foreground="{DynamicResource ForegroundColor}"
                              BorderBrush="{DynamicResource ControlBorder}"
                              BorderThickness="1"
                              ToolTip="Select one or more projects to include in analysis">
                    <DockPanel>
                        <Path DockPanel.Dock="Right"
                              Data="M 0 0 L 4 4 L 8 0 Z"
                              Fill="{DynamicResource ForegroundColor}"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0"/>
                        <TextBlock x:Name="txtProjectsSummary"
                                   Text="(all)"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </ToggleButton>

                <Popup IsOpen="{Binding IsChecked, ElementName=btnProjects}"
                       PlacementTarget="{Binding ElementName=btnProjects}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorder}"
                            BorderThickness="1"
                            CornerRadius="2"
                            MinWidth="180">
                        <ListBox x:Name="lstProjects"
                                 MaxHeight="320"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding ProjectId}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Foreground="{DynamicResource ForegroundColor}"
                                              Margin="8,4"
                                              Checked="ProjectCheck_Changed"
                                              Unchecked="ProjectCheck_Changed"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>

            <Rectangle Width="1" Fill="{DynamicResource ControlBorder}" Margin="12,2"/>

            <!-- Source: Local (aggregate from local Activities) vs. Snapshot (open
                 the picker dialog and aggregate from selected Azure snapshots). -->
            <TextBlock Text="Source:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <RadioButton x:Name="rbSourceLocal"
                         Content="Local"
                         GroupName="PhaseCodeSource"
                         IsChecked="True"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"
                         Foreground="{DynamicResource ForegroundColor}"
                         Checked="SourceRadio_Changed"
                         ToolTip="Aggregate from the local Activities table (default)."/>
            <RadioButton x:Name="rbSourceSnapshot"
                         Content="Snapshot"
                         GroupName="PhaseCodeSource"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"
                         Foreground="{DynamicResource ForegroundColor}"
                         Checked="SourceRadio_Changed"
                         ToolTip="Aggregate from selected Azure snapshots — opens a picker."/>
            <Button x:Name="btnReSelectSnapshots"
                    Content="Select"
                    Padding="6,2"
                    IsEnabled="False"
                    Click="BtnReSelectSnapshots_Click"
                    ToolTip="Open the snapshot picker to change the current selection."/>
            <TextBlock x:Name="txtSnapshotStatus"
                       Text=""
                       VerticalAlignment="Center"
                       FontSize="11"
                       Opacity="0.7"
                       Margin="8,0,0,0"
                       Foreground="{DynamicResource ForegroundColor}"/>

            <Rectangle Width="1" Fill="{DynamicResource ControlBorder}" Margin="12,2"/>

            <Button Content="Export"
                    Click="BtnExport_Click"
                    Padding="8,2"
                    ToolTip="Export current grid data to Excel"/>
        </StackPanel>

        <!-- Summary Grid -->
        <syncfusion:SfDataGrid x:Name="summaryGrid" Grid.Row="1"
                               Margin="8,0,8,8"
                               AutoGenerateColumns="False"
                               AllowSorting="True"
                               AllowFiltering="True"
                               AllowDraggingColumns="True"
                               AllowResizingColumns="True"
                               IsReadOnly="True"
                               SelectionMode="Single"
                               NavigationMode="Row"
                               ColumnSizer="Star"
                               HeaderRowHeight="32"
                               RowHeight="28"
                               GridLinesVisibility="Both"
                               HeaderLinesVisibility="Both">
            <syncfusion:SfDataGrid.HeaderStyle>
                <Style TargetType="syncfusion:GridHeaderCellControl">
                    <Setter Property="Background" Value="{DynamicResource GridHeaderBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource GridHeaderForeground}"/>
                </Style>
            </syncfusion:SfDataGrid.HeaderStyle>
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn x:Name="colGroupValue"
                                           MappingName="GroupValue"
                                           HeaderText="Group"
                                           AllowFiltering="True"
                                           AllowSorting="True"
                                           Width="150"/>
                <syncfusion:GridNumericColumn MappingName="BudgetMHs"
                                              HeaderText="BudgetMHs"
                                              NumberDecimalDigits="1"
                                              AllowFiltering="True"
                                              AllowSorting="True"/>
                <syncfusion:GridNumericColumn MappingName="EarnedMHs"
                                              HeaderText="EarnedMHs"
                                              NumberDecimalDigits="1"
                                              AllowFiltering="True"
                                              AllowSorting="True"/>
                <syncfusion:GridNumericColumn MappingName="Quantity"
                                              HeaderText="Quantity"
                                              NumberDecimalDigits="1"
                                              AllowFiltering="True"
                                              AllowSorting="True"/>
                <syncfusion:GridNumericColumn MappingName="QtyEarned"
                                              HeaderText="QtyEarned"
                                              NumberDecimalDigits="1"
                                              AllowFiltering="True"
                                              AllowSorting="True"/>
                <syncfusion:GridNumericColumn MappingName="PercentComplete"
                                              HeaderText="% Complete"
                                              NumberDecimalDigits="1"
                                              AllowFiltering="True"
                                              AllowSorting="True"
                                              CellStyle="{StaticResource PercentColorStyle}"/>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <!-- Busy overlay for the summary grid during async snapshot aggregation. -->
        <Border x:Name="summaryBusyOverlay" Grid.Row="1"
                Background="{DynamicResource OverlayBackground}"
                Visibility="Collapsed"
                Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <syncfusion:SfBusyIndicator IsBusy="True"
                                            AnimationType="DualRing"
                                            ViewboxWidth="64"
                                            ViewboxHeight="64"
                                            Foreground="{DynamicResource AccentColor}"/>
                <TextBlock Text="Aggregating snapshot data..."
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource OverlayText}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
