<Window x:Class="VANTAGE.Dialogs.TutorialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        Title="Tutorials"
        Height="785"
        Width="520"
        MinHeight="320"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundColor}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource DarkestBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel>
                <TextBlock Text="Tutorials"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ToolbarForeground}"/>
                <TextBlock Text="Select a video to watch."
                           FontSize="11"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource StatusBarForeground}"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="listTutorials" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="TutorialItem_Click"
                                    Margin="4"
                                    Padding="12,10"
                                    Background="{DynamicResource ControlBackground}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    HorizontalContentAlignment="Stretch"
                                    Cursor="Hand"
                                    ToolTip="Watch this tutorial">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ForegroundColor}"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource StatusBarForeground}"/>
                                    </StackPanel>

                                    <!-- Watched badge: subtle accent-outlined pill, shown only once opened -->
                                    <Border x:Name="watchedBadge"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0"
                                            Padding="8,3"
                                            CornerRadius="9"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource AccentColor}"
                                            Background="Transparent"
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x2713;"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentColor}"/>
                                            <TextBlock Text="Watched"
                                                       FontSize="10"
                                                       Margin="4,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentColor}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Watched}" Value="True">
                                    <Setter TargetName="watchedBadge" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Loading / status overlay -->
            <Border x:Name="loadingOverlay" Background="{DynamicResource BackgroundColor}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <syncfusion:SfBusyIndicator x:Name="busyIndicator"
                                                IsBusy="True"
                                                AnimationType="DualRing"
                                                ViewboxWidth="40"
                                                ViewboxHeight="40"
                                                Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock x:Name="txtStatus"
                               Text="Loading tutorials…"
                               FontSize="13"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource ForegroundColor}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
